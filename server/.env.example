PORT=5000
MONGODB_URI=mongodb://localhost:27017/shareddocs
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
# Or set REDIS_URL=memory to skip Redis entirely (local dev only)

# Storage — set STORAGE_TYPE to 'local' for dev, 's3' or 'r2' for prod
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=./uploads

# S3 / Cloudflare R2 (used when STORAGE_TYPE=s3 or r2)
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com

CLIENT_URL=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:5000

# Invite emails (Gmail example: SMTP_HOST=smtp.gmail.com, port 587, use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Alamait <noreply@alamait.local>"

# OnlyOffice (for editing docx/xlsx/pptx in browser)
ONLYOFFICE_DS_URL=http://localhost:8082
ONLYOFFICE_SERVER_URL=http://host.docker.internal:5000
ONLYOFFICE_JWT_SECRET=change-me

# Microsoft 365 Online (optional)
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_REDIRECT_URI=http://localhost:5000/api/ms365/callback
